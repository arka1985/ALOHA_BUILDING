      <PolyStyle><color>8000a5ff</color></PolyStyle>
    </Style>
    <Style id="yellowZone">
      <LineStyle><color>ff00ffff</color></LineStyle>
      <PolyStyle><color>8000ffff</color></PolyStyle>
    </Style>
    <Placemark>
      <name>Red Zone</name>
      <styleUrl>#redZone</styleUrl>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              77.2090,28.6139,0
