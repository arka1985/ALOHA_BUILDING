              77.2110,28.6159,0
              77.2080,28.6159,0
              77.2080,28.6129,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>Yellow Zone</name>
      <styleUrl>#yellowZone</styleUrl>
      <Polygon>
        <outerBoundaryIs>
